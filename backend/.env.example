# =============================================================================
# RAG Textbook Chatbot Backend - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# SECURITY WARNING: Never commit your .env file to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED: Google AI API Configuration
# -----------------------------------------------------------------------------

# Google AI API key for Gemini models (embedding and LLM inference)
# Obtain from: https://aistudio.google.com/app/apikey
# 1. Sign in with your Google account
# 2. Click "Create API Key"
# 3. Copy the generated key
GOOGLE_API_KEY=your_google_api_key_here

# -----------------------------------------------------------------------------
# REQUIRED: Qdrant Vector Database Configuration
# -----------------------------------------------------------------------------

# Qdrant Cloud cluster URL
# Obtain from: https://cloud.qdrant.io/
# 1. Create a free Qdrant Cloud account
# 2. Create a new cluster (free tier available)
# 3. Copy the cluster URL (format: https://xxx-xxx.aws.cloud.qdrant.io)
QDRANT_URL=https://your-cluster-id.aws.cloud.qdrant.io

# Qdrant Cloud API key
# Obtain from: https://cloud.qdrant.io/
# 1. Go to your cluster dashboard
# 2. Navigate to "API Keys" section
# 3. Create a new API key and copy it
QDRANT_API_KEY=your_qdrant_api_key_here

# -----------------------------------------------------------------------------
# OPTIONAL: Logging Configuration
# -----------------------------------------------------------------------------

# Logging level for the application
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Default: INFO
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# OPTIONAL: Qdrant Collection Configuration
# -----------------------------------------------------------------------------

# Name of the Qdrant collection storing book chunk embeddings
# This should match the collection created during book ingestion
# Default: book_chunks
COLLECTION_NAME=book_chunks

# -----------------------------------------------------------------------------
# OPTIONAL: Model Configuration
# -----------------------------------------------------------------------------

# Google embedding model for vector similarity search
# Available models: https://ai.google.dev/gemini-api/docs/models/gemini#text-embedding
# Recommended: models/text-embedding-004 (768 dimensions, best quality)
# Default: models/text-embedding-004
EMBEDDING_MODEL=models/text-embedding-004

# Google Gemini LLM model for chat responses
# Available models: https://ai.google.dev/gemini-api/docs/models/gemini
# Options:
#   - gemini-2.0-flash (recommended, fast and capable)
#   - gemini-1.5-flash (alternative, good balance)
#   - gemini-1.5-pro (higher quality, slower)
# Default: gemini-2.0-flash
LLM_MODEL=gemini-2.0-flash

# -----------------------------------------------------------------------------
# OPTIONAL: Retrieval Configuration
# -----------------------------------------------------------------------------

# Minimum similarity score threshold for retrieved chunks (0.0 to 1.0)
# Higher values = stricter matching, fewer but more relevant results
# Lower values = looser matching, more results but potentially less relevant
# Recommended range: 0.6 - 0.8
# Default: 0.7
SCORE_THRESHOLD=0.7

# -----------------------------------------------------------------------------
# OPTIONAL: Server Configuration (for local development)
# -----------------------------------------------------------------------------

# Host address for the FastAPI server
# Default: 0.0.0.0 (accessible from all interfaces)
HOST=0.0.0.0

# Port for the FastAPI server
# Default: 7860 (Hugging Face Spaces requirement)
PORT=7860
