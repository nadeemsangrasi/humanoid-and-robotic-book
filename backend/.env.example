# RAG Textbook Chatbot Backend - Environment Variables
# Copy this file to .env and fill in your actual values

# =============================================================================
# REQUIRED: API Keys and URLs
# =============================================================================

# Google AI API Key for Gemini models (embedding and LLM inference)
# Get your key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Qdrant Cloud Configuration
# Get your cluster URL and API key at: https://cloud.qdrant.io/
QDRANT_URL=https://your-cluster-id.aws.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here

# Better Auth Secret Key for JWT Validation
# IMPORTANT: This MUST match the BETTER_AUTH_SECRET in your frontend .env
# This secret is used to validate JWT tokens issued by the frontend auth system
# Generate a secure random string (at least 32 characters recommended)
# Example: openssl rand -base64 32
BETTER_AUTH_SECRET=your_better_auth_secret_here

# =============================================================================
# OPTIONAL: Configuration with defaults
# =============================================================================

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL (default: INFO)
LOG_LEVEL=INFO

# Qdrant collection name for book embeddings (default: book_chunks)
COLLECTION_NAME=book_chunks

# Google embedding model (default: models/text-embedding-004)
EMBEDDING_MODEL=models/text-embedding-004

# Google Gemini LLM model (default: gemini-2.0-flash)
LLM_MODEL=gemini-2.0-flash

# Similarity score threshold for retrieval (0.0-1.0, default: 0.7)
SCORE_THRESHOLD=0.7

# Server configuration (defaults optimized for Hugging Face Spaces)
HOST=0.0.0.0
PORT=7860
